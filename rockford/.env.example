# Copy to .env and fill in. Never commit .env.

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Public address of the site (used for canonical URLs, sitemap, Open Graph, email links)
SITE_URL=https://rockfordacademy.com

# Long random secret. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Behind Nginx/Caddy/a load balancer that sets X-Forwarded-For
TRUST_PROXY=true
COOKIE_SECURE=true

# Where the database, private CVs and backups live (keep OUTSIDE the web root; default ./storage)
DATA_DIR=storage

# Upload limits (MB)
CV_MAX_MB=5
IMAGE_MAX_MB=4
FLYER_MAX_MB=8

# Email. "outbox" saves messages to storage/outbox without sending (no delivery).
# For real delivery set MAIL_TRANSPORT=smtp and the SMTP_* values from Google Workspace / Microsoft 365 / your provider.
MAIL_TRANSPORT=outbox
MAIL_FROM="Rockford Academy <no-reply@rockfordacademy.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# What the admin panel can manage:
#   jobs = only vacancies and job flyers (default)
#   full = every section (programmes, news, applications, settings, users...)
ADMIN_SCOPE=jobs
